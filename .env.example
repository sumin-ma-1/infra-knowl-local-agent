# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Inventory (YAML front matter Markdown)
INVENTORY_DIR=inventory

# Agent loop
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120

# Telegram bot frontend (BotFather token). Empty = bot disabled.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids. Empty = all chats. Set this before joining a real group.
# Group ids are negative, e.g. -1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=

# User-account (Telethon) history index. Bot API cannot read old group messages.
# api_id / api_hash: https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Comma-separated Bot API chat ids (groups are negative). Inline comments ok.
# Removing an id here deletes that room's local history on the next sync.
TELEGRAM_INDEX_CHATS=
# TELEGRAM_SESSION_PATH=data/telegram-user
# TELEGRAM_INDEX_DB=data/telegram-index.sqlite
# TELEGRAM_INDEX_INTERVAL_SECONDS=900
# TELEGRAM_INDEX_MAX_MESSAGES=0

# Nextcloud (one Obsidian note over WebDAV). App password only — not the login password.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_FILE_PATH=
